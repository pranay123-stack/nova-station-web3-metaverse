# ─────────────────────────────────────────────────────────────────────────────
# NOVA STATION — environment
#
# Copy to .env (root), apps/server/.env and apps/web/.env.local as noted below.
# Nothing here is a secret in development; everything marked REQUIRED IN
# PRODUCTION must be set to a real value before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════ SERVER ══════════════════════════════════
# → apps/server/.env

NODE_ENV=development
PORT=4300
HOST=0.0.0.0

# PostgreSQL. `pnpm db:up` starts one on 5491 with these credentials.
DATABASE_URL=postgresql://nova:nova@localhost:5491/nova_station

# Browser origins allowed to call the API. Comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3300,http://127.0.0.1:3300

# Used to build the SIWE message. SIWE_DOMAIN must match the host a player
# actually visits, or their wallet will display a different site than the one
# the server checks.
PUBLIC_WEB_ORIGIN=http://localhost:3300
SIWE_DOMAIN=localhost:3300

# REQUIRED IN PRODUCTION. At least 32 characters; sessions are signed with it.
# Rotating it invalidates every live session.
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=72

# ─────────────────────────────── chain (server) ──────────────────────────────
# 11155111 = Sepolia, 31337 = local anvil.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Written by `pnpm chain:deploy:local` into contracts/deployments/<chainId>.json.
CONTRACT_ASSETS=
CONTRACT_ITEMS=
CONTRACT_MARKETPLACE=
CONTRACT_REWARD_VAULT=

# The key the server mints assets and signs reward vouchers with. It needs
# MINTER_ROLE on NovaAssets/NovaItems and SIGNER_ROLE on NovaRewardVault.
# Leave empty to run the game with on-chain minting disabled — everything else
# works, and the UI says so rather than pretending.
MINTER_PRIVATE_KEY=

# Chain indexer. Set INDEXER_START_BLOCK to the deployment block so a fresh
# database does not scan from genesis.
INDEXER_ENABLED=true
INDEXER_POLL_MS=6000
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=2

# ───────────────────────────── limits and logging ────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# The sign-in endpoints are limited separately and much harder.
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# ═══════════════════════════════════ WEB ════════════════════════════════════
# → apps/web/.env.local
# Everything NEXT_PUBLIC_* is compiled into the browser bundle. Never put a
# secret behind that prefix.

NEXT_PUBLIC_API_URL=http://localhost:4300
NEXT_PUBLIC_WS_URL=ws://localhost:4300/ws
NEXT_PUBLIC_CHAIN_ID=31337

# Optional: a public RPC for read-only calls. Falls back to the chain default.
NEXT_PUBLIC_RPC_URL=

# Same addresses as above; the browser needs them to build transactions.
NEXT_PUBLIC_CONTRACT_ASSETS=
NEXT_PUBLIC_CONTRACT_ITEMS=
NEXT_PUBLIC_CONTRACT_MARKETPLACE=
NEXT_PUBLIC_CONTRACT_REWARD_VAULT=

# ════════════════════════════════ CONTRACTS ═════════════════════════════════
# → contracts/.env (only needed to deploy)

# A funded deployer key. On Sepolia, fund it from a faucet first.
PRIVATE_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Roles granted at deploy time. Default to the deployer when unset.
NOVA_MINTER=
NOVA_SIGNER=
NOVA_TREASURY=
NOVA_BASE_URI=https://nova.example/metadata/
