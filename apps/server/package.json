{
  "name": "@nova/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs",
    "dev": "prisma generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "verify:chain": "node scripts/verify-chain.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nova/game-data": "workspace:*",
    "@nova/game-engine": "workspace:*",
    "@nova/shared": "workspace:*",
    "@nova/web3": "workspace:*",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "viem": "2.55.19",
    "ws": "8.21.3",
    "zod": "4.4.3",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0",
    "@prisma/client-runtime-utils": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "dotenv": "17.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/pg": "8.23.1"
  }
}
